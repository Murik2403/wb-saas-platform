# Copy this file to .env and fill in real values before `docker compose up`.
# See DEPLOY.md for the full walkthrough (DNS, first boot, etc).

# The domain the gateway (registration/login) is served on. Must have an A
# record pointing at this server, PLUS a wildcard A record for
# *.app.<this domain> (every tenant subdomain) pointing at the same server.
WB_SAAS_PARENT_DOMAIN=wbsaas.example.com

# Subdomain prefix tenants live under: {slug}.<this>.${WB_SAAS_PARENT_DOMAIN}
WB_SAAS_TENANT_SUBDOMAIN_PREFIX=app

# Email Let's Encrypt will send certificate-expiry/problem notices to.
WB_SAAS_ACME_EMAIL=you@example.com

# Docker image tag every newly-provisioned tenant container is created
# from. Build it first: docker build -t wb-dashboard-tenant:latest ./tenant-app
WB_SAAS_TENANT_IMAGE=wb-dashboard-tenant:latest

WB_SAAS_DOCKER_NETWORK=wbsaas_net
WB_SAAS_TENANT_INTERNAL_PORT=8501
WB_SAAS_TENANT_MEM_LIMIT=384m
WB_SAAS_TENANT_CPU_QUOTA=1.0
WB_SAAS_PROVISION_TIMEOUT=180
WB_SAAS_IDLE_AUTO_STOP_ENABLED=1
WB_SAAS_TENANT_IDLE_TIMEOUT_MINUTES=30

# 1 in production (HTTPS is live) -- keeps session cookies from ever being
# sent over plain HTTP. Keep 0 only for local http://localhost testing.
WB_SAAS_COOKIE_SECURE=1

# --- Billing (trial -> paid subscription via YooKassa) --------------------
# See DEPLOY.md "Оплата (ЮKassa)" for how to get the shop id/secret key and
# register the webhook.

# Free trial length for a newly-registered account, in days.
WB_SAAS_TRIAL_DAYS=14

# How many days one paid period covers (recurring charge runs this often).
WB_SAAS_BILLING_PERIOD_DAYS=30

# Price of one period, in RUB.
WB_SAAS_SUBSCRIPTION_PRICE_RUB=2990

# After a trial ends unpaid, or a recurring charge fails, the account keeps
# access for this many extra days (status past_due) before being cancelled
# and its container stopped.
WB_SAAS_GRACE_PERIOD_DAYS=5

# From your shop's settings in the YooKassa merchant dashboard
# (https://yookassa.ru/my). Leave blank to disable checkout (accounts can
# still register and use their trial, but /billing/checkout will fail).
WB_SAAS_YOOKASSA_SHOP_ID=
WB_SAAS_YOOKASSA_SECRET_KEY=

# --- Password reset (see DEPLOY.md "Восстановление пароля (SMTP)") --------

# How long a reset link stays valid after being requested, in minutes.
WB_SAAS_PASSWORD_RESET_TTL_MINUTES=60

# Leave WB_SAAS_SMTP_HOST blank to disable actually sending mail -- the
# gateway still runs and reset links are logged instead of delivered,
# which is fine for a first boot/smoke test but means nobody can actually
# reset their password until this is filled in.
WB_SAAS_SMTP_HOST=
WB_SAAS_SMTP_PORT=587
WB_SAAS_SMTP_USER=
WB_SAAS_SMTP_PASSWORD=
# 1 for STARTTLS on a plaintext-then-upgrade port (587, the common case).
WB_SAAS_SMTP_USE_STARTTLS=1
WB_SAAS_SMTP_FROM_EMAIL=no-reply@wbsaas.example.com

# --- Telegram support relay (see gateway/telegram_bot.py) ------------------

# Create a bot via @BotFather (get the token), then message @userinfobot to
# get your own numeric chat id. Leave WB_SAAS_TELEGRAM_BOT_TOKEN blank to
# disable the relay entirely -- the gateway runs fine without it.
WB_SAAS_TELEGRAM_BOT_TOKEN=
WB_SAAS_TELEGRAM_OWNER_CHAT_ID=

# --- Host-level backups (see DEPLOY.md "Бэкапы") ---------------------------

# Host directory tar.gz snapshots of every tenant's Docker volume are
# written to (one subfolder per client). Point a separate offsite sync
# tool (rsync/rclone/S3, your choice) at this same path.
WB_SAAS_BACKUP_DIR=/opt/wb-saas/backups
WB_SAAS_BACKUP_KEEP_DAYS=14
