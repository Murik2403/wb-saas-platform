# Copy this file to .env and fill in real values before `docker compose up`.
# See DEPLOY.md for the full walkthrough (DNS, first boot, etc).

# The domain the gateway (registration/login) is served on. Must have an A
# record pointing at this server, PLUS a wildcard A record for
# *.app.<this domain> (every tenant subdomain) pointing at the same server.
WB_SAAS_PARENT_DOMAIN=wbsaas.example.com

# Subdomain prefix tenants live under: {slug}.<this>.${WB_SAAS_PARENT_DOMAIN}
WB_SAAS_TENANT_SUBDOMAIN_PREFIX=app

# Email Let's Encrypt will send certificate-expiry/problem notices to.
WB_SAAS_ACME_EMAIL=you@example.com

# Docker image tag every newly-provisioned tenant container is created
# from. Build it first: docker build -t wb-dashboard-tenant:latest ./tenant-app
WB_SAAS_TENANT_IMAGE=wb-dashboard-tenant:latest

WB_SAAS_DOCKER_NETWORK=wbsaas_net
WB_SAAS_TENANT_INTERNAL_PORT=8501
WB_SAAS_TENANT_MEM_LIMIT=768m
WB_SAAS_TENANT_CPU_QUOTA=1.0
# Shared start budget for tenant containers (provisioner/tenant_budget.py). A cabinet is admitted while
# (reservations of running cabinets + this one) fit the budget AND the host keeps MIN_AVAILABLE free.
# Reservation is what a cabinet normally needs (soft limit); MEM_LIMIT above stays the hard ceiling.
WB_SAAS_TENANT_MEM_RESERVATION=384m
# Empty = WB_SAAS_TENANT_MEMORY_FRACTION of host RAM; a size like 10g; "off" = no cap.
WB_SAAS_TENANT_MEMORY_BUDGET=
WB_SAAS_TENANT_MEMORY_FRACTION=0.7
WB_SAAS_TENANT_MIN_AVAILABLE=1g
# Seconds a start waits inside the provisioner for room (max 15); 0 = refuse at once with 503, the gateway then waits.
WB_SAAS_TENANT_ADMISSION_WAIT=0
# Shared PDF memory budget: one host directory every tenant mounts at /pdf-slots; each report PDF holds one of
# WB_SAAS_PDF_SLOTS OS-locked slot files, so at most that many PDFs render on the host at once (measured: ~200-300 MiB
# extra per render, CPU-bound). Empty = off: a tenant then only renders one PDF at a time. Applies to tenants created or
# upgraded after the setting is on (the mount is part of the container).
WB_SAAS_PDF_SLOT_HOST_DIR=
WB_SAAS_PDF_SLOTS=2
# Gateway: how long a new signup waits for room before it is marked failed, and the retry step.
WB_SAAS_PROVISION_CAPACITY_WAIT=900
WB_SAAS_PROVISION_CAPACITY_RETRY=20
WB_SAAS_PROVISION_TIMEOUT=180

# 1 in production (HTTPS is live) -- keeps session cookies from ever being
# sent over plain HTTP. Keep 0 only for local http://localhost testing.
WB_SAAS_COOKIE_SECURE=1

# --- Public site: analytics and search-engine verification ----------------
# All three are optional. Left empty (the default), the corresponding tag is
# not rendered at all -- no tracker is loaded in dev, tests or CI.

# Yandex.Metrika counter number (digits only), from metrika.yandex.ru after
# creating a counter for the public domain. Enables the counter on the
# allow-listed public pages after an explicit analytics choice.
WB_SAAS_YANDEX_METRIKA_ID=
# Optional separate HMAC key for consent/acquisition cookies. If empty, the
# existing INTERNAL_API_SECRET is used with purpose separation. With neither
# configured, optional analytics stays disabled.
WB_SAAS_GROWTH_COOKIE_SECRET=

# Ownership-verification tokens. Yandex: webmaster.yandex.ru -> add site ->
# "Мета-тег", copy the content="..." value only. Google: Search Console ->
# HTML tag method, same thing. Both can be removed once verified, but
# keeping them prevents losing verification later.
WB_SAAS_YANDEX_VERIFICATION=
WB_SAAS_GOOGLE_VERIFICATION=

# --- Billing (trial -> paid subscription via YooKassa) --------------------
# See DEPLOY.md "Оплата (ЮKassa)" for how to get the shop id/secret key and
# register the webhook.

# Free trial length for a newly-registered account, in days.
WB_SAAS_TRIAL_DAYS=14

# How many days one paid period covers (recurring charge runs this often).
WB_SAAS_BILLING_PERIOD_DAYS=30

# Price of one period, in RUB.
WB_SAAS_SUBSCRIPTION_PRICE_RUB=2990

# After a trial ends unpaid, or a recurring charge fails, the account keeps
# access for this many extra days (status past_due) before being cancelled
# and its container stopped.
WB_SAAS_GRACE_PERIOD_DAYS=5

# From your shop's settings in the YooKassa merchant dashboard
# (https://yookassa.ru/my). Leave blank to disable checkout (accounts can
# still register and use their trial, but /billing/checkout will fail).
WB_SAAS_YOOKASSA_SHOP_ID=
WB_SAAS_YOOKASSA_SECRET_KEY=
# Request the current notification CIDR ranges from your YooKassa manager.
# Empty is intentionally fail-closed: /webhooks/yookassa will return 503.
WB_SAAS_YOOKASSA_WEBHOOK_CIDRS=

# --- Password reset (see DEPLOY.md "Восстановление пароля (SMTP)") --------

# How long a reset link stays valid after being requested, in minutes.
WB_SAAS_PASSWORD_RESET_TTL_MINUTES=60
# Bounded server-side HIBP password range check for registration and reset.
WB_SAAS_HIBP_TIMEOUT_SECONDS=3

# Leave WB_SAAS_SMTP_HOST blank to disable actually sending mail -- the
# gateway still runs and reset links are logged instead of delivered,
# which is fine for a first boot/smoke test but means nobody can actually
# reset their password until this is filled in.
WB_SAAS_SMTP_HOST=
WB_SAAS_SMTP_PORT=587
WB_SAAS_SMTP_USER=
WB_SAAS_SMTP_PASSWORD=
# 1 for STARTTLS on a plaintext-then-upgrade port (587, the common case).
WB_SAAS_SMTP_USE_STARTTLS=1
WB_SAAS_SMTP_FROM_EMAIL=no-reply@wbsaas.example.com

# --- Telegram support relay (see gateway/telegram_bot.py) ------------------

# Set 0 to pause Telegram in gateway and all newly created/upgraded tenants.
WB_SAAS_TELEGRAM_ENABLED=1

# Create a bot via @BotFather (get the token), then message @userinfobot to
# get your own numeric chat id. Leave WB_SAAS_TELEGRAM_BOT_TOKEN blank to
# disable the relay entirely -- the gateway runs fine without it.
WB_SAAS_TELEGRAM_BOT_TOKEN=
WB_SAAS_TELEGRAM_OWNER_CHAT_ID=

# --- Internal API (tenant containers -> gateway, e.g. email/Telegram report
# delivery) -- see gateway/internal_routes.py --------------------------------

# Shared secret every tenant container uses to authenticate to the gateway's
# internal API. Leave blank to disable the feature entirely (report delivery
# via email/Telegram from tenant-app will silently no-op, not error) --
# generate a real random value before relying on it, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WB_SAAS_INTERNAL_API_SECRET=
# Only for the standalone redesign tenant Compose profile. This is a scoped
# credential for slug `redesign`, not the gateway master secret above.
WB_SAAS_REDESIGN_INTERNAL_API_SECRET=
# Maximum scheduled-report PDF received by the gateway from one tenant (20 MiB).
WB_SAAS_MAX_REPORT_UPLOAD_BYTES=20971520

# --- Error reporting (opt-in Sentry DSNs; empty means no telemetry) -------
WB_SAAS_SENTRY_DSN=
# Tenant dashboards inherit WB_SAAS_SENTRY_DSN when this is left empty.
WB_SAAS_SENTRY_TENANT_DSN=
WB_SAAS_SENTRY_ENVIRONMENT=production

# --- Admin panel access (see gateway/admin_routes.py) -----------------------

# Comma-separated emails allowed into /admin. Empty means nobody can access
# it (not "everybody") -- see gateway/logic/accounts.py's is_admin().
WB_SAAS_ADMIN_EMAILS=

# --- Host-level backups (see DEPLOY.md "Бэкапы") ---------------------------

# Host directory tar.gz snapshots of every tenant's Docker volume are
# written to (one subfolder per client). Point a separate offsite sync
# tool (rsync/rclone/S3, your choice) at this same path.
WB_SAAS_BACKUP_DIR=/opt/wb-saas/backups
WB_SAAS_BACKUP_KEEP_DAYS=14
# Generate two independent 32+ character secrets. The tenant master key stays
# in gateway; provisioner receives only the backup key and tenant-derived keys.
WB_SAAS_TENANT_ENCRYPTION_MASTER_KEY=
# Current key id and optional JSON map of retained historical tenant backup keys.
# Example: {"2026-09-12":"<fernet-key>"}
WB_SAAS_TENANT_ENCRYPTION_KEY_ID=current
WB_SAAS_TENANT_ENCRYPTION_KEYRING=
WB_SAAS_BACKUP_ENCRYPTION_KEY=

# Keep 0 for the direct public Traefik deployment. Set this only when an
# external proxy/CDN is configured as trusted in traefik/traefik.yml.
WB_SAAS_TRUSTED_PROXY_HOPS=0

# --- Control-plane database (see DEPLOY.md "Переключение control-plane
# базы на Postgres") ---------------------------------------------------

# "sqlite" (default) or "postgres". Leave as sqlite unless you've actually
# hit contention on the control-plane db -- switching is a deliberate,
# multi-step cutover, not a flag to flip casually.
WB_SAAS_DB_BACKEND=sqlite
WB_SAAS_DATABASE_URL=

# Only read by the optional `postgres` service below (profiles: [postgres],
# so `docker compose up -d` never starts it on its own -- see docker-compose.yml).
# No default on purpose: unlike POSTGRES_USER/POSTGRES_DB, a password must
# be deliberately set, never silently blank.
WB_SAAS_POSTGRES_USER=wbsaas
WB_SAAS_POSTGRES_PASSWORD=
WB_SAAS_POSTGRES_DB=wbsaas

# --- Strix AI pentesting (scripts/run_strix_scan.ps1, CI workflow
# .github/workflows/strix.yml) ------------------------------------------

# Only needed to run security scans; the platform itself never reads these.
# Model id in LiteLLM form ("<provider>/<model>") and the key for that
# provider -- see https://docs.strix.ai/llm-providers/overview. Strix bills
# straight to this key, so a deep scan costs real money; the quick scan CI
# runs on pull requests is the cheap one.
# In GitHub Actions the same two values come from repository secrets with
# these exact names, not from this file.
STRIX_LLM=anthropic/claude-sonnet-5
LLM_API_KEY=

# Public mobile association settings. Empty until actual signing IDs exist.
# SHA-256 fingerprints are comma-separated; use the certificate of the installed build.
WB_SAAS_ANDROID_PACKAGE=
WB_SAAS_ANDROID_SHA256=
# Actual Apple application identifier: <ApplicationIdentifierPrefix>.<BundleIdentifier>.
WB_SAAS_IOS_APP_ID=
