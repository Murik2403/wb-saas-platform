FROM node:22-alpine AS frontend-build

WORKDIR /frontend
ARG VITE_MH_API_BASE_URL=
ARG VITE_MH_API_MODE=v1
ENV VITE_MH_API_BASE_URL=$VITE_MH_API_BASE_URL \
    VITE_MH_API_MODE=$VITE_MH_API_MODE
COPY mh-redesign-lab/package.json mh-redesign-lab/package-lock.json ./
RUN npm ci
COPY mh-redesign-lab/index.html ./
COPY mh-redesign-lab/tsconfig.json mh-redesign-lab/tsconfig.node.json mh-redesign-lab/vite.config.ts ./
COPY mh-redesign-lab/src ./src
RUN npm run build

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NGINX_ENTRYPOINT_QUIET_LOGS=1 \
    WB_SAAS_REPORT_ISOLATED_METRICS=1

WORKDIR /app/tenant-app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

COPY tenant-app/requirements.txt ./
RUN python -m pip install --no-cache-dir 'pip>=26.2,<27' && pip install --no-cache-dir -r requirements.txt

COPY tenant-app/ ./
# The redesign owns its additive API adapter; the Streamlit source tree remains
# unchanged on disk and remains available for rollback.
ARG REDESIGN_BUILD_ID=dev
RUN printf '%s' "$REDESIGN_BUILD_ID" > /tmp/redesign-build-id
COPY mh-redesign-lab/tenant-api/api_server.py ./api_server.py
COPY mh-redesign-lab/tenant-api/dashboard_cache.py ./dashboard_cache.py
COPY mh-redesign-lab/tenant-api/sync_runner.py ./sync_runner.py
COPY mh-redesign-lab/tenant-api/request_security.py ./request_security.py
COPY mh-redesign-lab/tenant-api/action_plan_executor.py ./action_plan_executor.py
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html
COPY mh-redesign-lab/deploy/nginx.tenant-staging.conf /etc/nginx/conf.d/default.conf
COPY mh-redesign-lab/deploy/tenant-staging-entrypoint.sh /usr/local/bin/tenant-staging-entrypoint

RUN chmod +x /usr/local/bin/tenant-staging-entrypoint /app/tenant-app/docker-entrypoint.sh \
    && mkdir -p /app/tenant-app/data

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/healthz', timeout=3)"

EXPOSE 8501
VOLUME ["/app/tenant-app/data"]
ENTRYPOINT ["/usr/local/bin/tenant-staging-entrypoint"]
