{
  "name": "mh-redesign-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "api:tenant": "powershell -ExecutionPolicy Bypass -File scripts/start-tenant-api.ps1",
    "api:bridge": "powershell -ExecutionPolicy Bypass -File scripts/start-api-bridge.ps1",
    "qa:layout": "node scripts/measure-layout.mjs",
    "qa:mobile-finance": "node scripts/audit-mobile-finance.mjs",
    "qa:mobile-navigation": "node scripts/audit-mobile-navigation.mjs",
    "qa:mobile-task-plan": "node scripts/audit-mobile-task-plan.mjs",
    "qa:pages": "node scripts/audit-all-pages.mjs",
    "qa:staging": "node scripts/check-staging.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.0"
  }
