{
  "compilerOptions": {
    "target": "ES2019",
    "module": "esnext",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "www"
  },
  "include": ["src/**/*.js"]
}
