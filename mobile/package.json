{
  "name": "marketshelper-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell for MARKETSHELPER (Android + iOS)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets:source": "node scripts/make-assets.mjs",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor #0b1115 --splashBackgroundColor #0b1115",
    "sync": "npm run build && cap sync",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
